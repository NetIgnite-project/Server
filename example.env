
NETIGNITE_LOG_LEVEL=info

# Booleans: exactly "true" or "false" (case-sensitive); anything else — including an empty value — fails at startup.
# An unset variable falls back to the schema default.
NETIGNITE_API_DISABLE_DOCS=false

NETIGNITE_DB_PATH=./data/netignite.sqlite
NETIGNITE_DB_AUTO_MIGRATE=true
NETIGNITE_DB_MIGRATION_DIR=./drizzle/migrations

NETIGNITE_LOG_DIR=./data/logs
NETIGNITE_CONFIG_BASE_DIR=./config

NETIGNITE_APP_URL=http://localhost:18232

# ESP32 firmware for the web installer, synced from GitHub releases every 6 hours.
NETIGNITE_FIRMWARE_SYNC=true
NETIGNITE_FIRMWARE_REPO=NetIgnite-project/Agent-ESP32
NETIGNITE_FIRMWARE_DIR=./data/firmware
# Optional: PEM ECDSA P-256 public key; only releases with a valid firmware.sig are accepted.
# NETIGNITE_FIRMWARE_PUBLIC_KEY=./config/firmware-signing.pub.pem
# Optional: raises GitHub's API rate limit.
# NETIGNITE_GITHUB_TOKEN=

# The agent's install scripts (/install/linux.sh, macos.sh, windows.ps1): GitHub repository, and
# optionally a fixed release tag (default: the newest stable release; a pre-release only while there
# is none). Server 2.0.0 called these NETIGNITE_LINUX_AGENT_REPO / _VERSION; those still work.
NETIGNITE_AGENT_REPO=NetIgnite-project/Agent-Linux
# NETIGNITE_AGENT_VERSION=v1.0.0

NETIGNITE_SMTP_HOST=mail.example.com
NETIGNITE_SMTP_PORT=465
NETIGNITE_SMTP_USERNAME=user
NETIGNITE_SMTP_PASSWORD=
NETIGNITE_SMTP_FROM='"App" <system@app.example.com>'
NETIGNITE_SMTP_SECURE=true