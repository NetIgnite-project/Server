{
	"name": "@netignite/server",
	"version": "2.0.0-dev",
	"private": true,
	"type": "module",
	"description": "NetIgnite server: dashboard, REST API and agent gateway",
	"scripts": {
		"check": "bunx --bun biome check",
		"check:ci": "bunx --bun biome ci",
		"format": "bunx --bun biome format --write",
		"lint": "bunx --bun biome lint",
		"typecheck": "bunx --bun nuxt typecheck && bunx --bun tsc -p ./tsconfig/tsconfig.typecheck.json && echo 'Typecheck passed!'",
		"test": "bun test",
		"test:ci": "bun test --coverage --reporter=junit --reporter-outfile=./junit.xml",
		"db:generate": "bun scripts/db-utils && bunx --bun drizzle-kit generate --config=drizzle/configs/drizzle.config.ts",
		"db:migrate": "bun scripts/db-utils && bunx --bun drizzle-kit migrate --config=drizzle/configs/drizzle.config.ts",
		"api-client:generate": "bun scripts/api-client-generate.ts",
		"dev": "bunx --bun nuxt dev --port 18232",
		"generate": "bunx --bun nuxt generate",
		"preview": "bunx --bun nuxt preview",
		"postinstall": "bunx --bun nuxt prepare",
		"build": "nuxt build --preset bun && bun build scripts/import-v1.ts --target bun --outfile .output/import-v1.mjs",
		"import-v1": "bun scripts/import-v1.ts",
		"start": "PORT=18232 bun run .output/server/index.mjs"
	},
	"dependencies": {
		"@cleverjs/utils": "^1.2.5",
		"@nuxt/ui": "^4.9.0",
		"@hono/standard-validator": "^0.3.0",
		"@scalar/hono-api-reference": "^0.11.9",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"hono": "^4.12.30",
		"hono-openapi": "^1.3.1",
		"nodemailer": "^9.0.0",
		"zod": "^4.4.3",
		"elliptic": "^6.6.1",
		"nuxt": "^4.6.2",
		"vue": "^3.5.39",
		"vue-router": "^5.1.0"
	},
	"devDependencies": {
		"@hey-api/nuxt": "^0.2.1",
		"@hey-api/openapi-ts": "^0.99.0",
		"@iconify-json/lucide": "^1.2.117",
		"@biomejs/biome": "^2.5.0",
		"@libsql/client": "^0.17.4",
		"@types/bun": "^1.4.3",
		"@types/nodemailer": "^8.0.1",
		"@types/elliptic": "^6.4.18",
		"drizzle-kit": "^0.31.10",
		"bun-types": "^1.4.2",
		"typescript": "^6.0.3",
		"vue-tsc": "^3.3.6"
	}
}
